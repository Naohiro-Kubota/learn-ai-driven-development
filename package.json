{
	"name": "approval-flow",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": "26.9.0",
		"pnpm": "12.5.1"
	},
	"scripts": {
		"build": "tsc -b && vite build",
		"dev": "vite",
		"test": "vitest run",
		"test:e2e": "node scripts/e2e-stack.mjs",
		"test:e2e:runner": "node --test scripts/e2e-stack.test.mjs",
		"test:db": "node scripts/test-postgres.mjs",
		"verify:openapi": "node scripts/verify-openapi.mjs",
		"typecheck": "tsc -b --pretty false",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check:gofmt": "node scripts/check-gofmt.mjs",
		"check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run check:gofmt"
	},
	"dependencies": {
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@biomejs/biome": "2.5.14",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"jsdom": "30.1.0",
		"typescript": "7.0.2",
		"yaml": "2.9.1",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	}
}
