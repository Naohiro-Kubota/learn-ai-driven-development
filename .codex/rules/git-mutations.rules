# `.git` is read-only in the workspace-write sandbox, so these commands already
# require an escalation. Keep that escalation interactive even if broader
# command permissions are later added.

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "コミット作成は明示的な承認を必要とします。",
    match = ["git commit -m message"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "リモートへの push は明示的な承認を必要とします。",
    match = ["git push origin HEAD:feature/example"],
    not_match = ["git fetch origin"],
)
