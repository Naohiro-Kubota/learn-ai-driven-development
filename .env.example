# Reference only; do not commit a populated .env file.
# For Compose, export LOCAL_DB_PASSWORD, KEYCLOAK_ADMIN_USERNAME,
# KEYCLOAK_ADMIN_PASSWORD, AUTH_TRANSACTION_KEY, and TEST_USER_PASSWORD.
# LOCAL_DB_PASSWORD should contain URL-safe characters (for example, hex).
# Compose sets the application variables below inside its containers.
LOCAL_DB_PASSWORD=
APP_ENV=development
APP_LOCAL_COMPOSE=
APP_LISTEN_ADDR=127.0.0.1:8080
APP_FRONTEND_ORIGIN=http://127.0.0.1:5173
APP_COOKIE_SECURE=false
VITE_API_ORIGIN=http://127.0.0.1:8080
OIDC_ISSUER=http://127.0.0.1:8081/realms/approval-flow-dev
OIDC_INTERNAL_ADDR=
OIDC_REDIRECT_URI=http://127.0.0.1:8080/auth/oidc/callback
OIDC_CLIENT_ID=
DATABASE_URL=
AUTH_TRANSACTION_KEY=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
TEST_USER_PASSWORD=
SESSION_IDLE_TTL=15m
SESSION_ABSOLUTE_TTL=8h
AUTH_TRANSACTION_TTL=5m
